APP_NAME="Triada Designs API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8088
# Local ops UI, or production dashboard origins
FRONTEND_URL=http://127.0.0.1:43127
# Comma-separated browser origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:43127,http://localhost:43127,https://dashboard.triada-designs.com,https://triada-ops.vercel.app
# Sanctum stateful domains (hostnames, no scheme)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:43127,127.0.0.1,127.0.0.1:43127,dashboard.triada-designs.com,triada-ops.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=triada
# DB_USERNAME=triada
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@triada-designs.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# local | live  (mock is accepted as an alias for local)
INTEGRATION_MODE=local

WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_WEBHOOK_SECRET=
WORDPRESS_TIMEOUT=15

# Shared with apps/web (Vercel) CRON_SECRET for abandonment / after-sale workers
CRON_SECRET=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
# Zoho Books organization ID (required for invoice PDF / UAE e-invoice — not CRM alone)
ZOHO_ORGANIZATION_ID=
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MODULE_LEADS=Leads
ZOHO_MODULE_CONTACTS=Contacts
ZOHO_WEBHOOK_SECRET=
ZOHO_TIMEOUT=15

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_API_VERSION=2025-01
# Triada Shopify store (Admin API token still awaiting — local_sim until token + live mode)
SHOPIFY_SHOP_DOMAIN=jwtjzw-nu.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory
SHOPIFY_TIMEOUT=20

# Meta messaging (Facebook / Instagram / WhatsApp Cloud). Empty = local simulator.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=triada-local-verify
META_WEBHOOK_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
META_TIMEOUT=15
# WhatsApp Cloud API — prefer META_WA_* (WHATSAPP_* aliases still work)
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_WEBHOOK_SECRET=
EMAIL_CHANNEL_PROVIDER=log
EMAIL_CHANNEL_API_KEY=
EMAIL_CHANNEL_FROM=
EMAIL_CHANNEL_WEBHOOK_SECRET=

# Resend (Laravel mail + email channel). Prefer EMAIL_CHANNEL_* for Integrations UI status.
MAIL_MAILER=log
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# When using Resend: MAIL_MAILER=resend, EMAIL_CHANNEL_PROVIDER=resend,
# EMAIL_CHANNEL_API_KEY=$RESEND_API_KEY, EMAIL_CHANNEL_FROM=hello@your-domain,
# EMAIL_CHANNEL_WEBHOOK_SECRET=whsec_…

# Supabase (shared with apps/web during Next dual-run; optional on Laravel host)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=

# LLM: anthropic (default / primary) | local | gemini | openai_compatible
# Prefer pasting ANTHROPIC_API_KEY on Integrations. Without a key agents stay on
# local heuristic (status: awaiting_credentials) — never fake Claude success.
# If only Gemini is available, set LLM_PROVIDER=gemini + GEMINI_API_KEY.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
# Gemini (env-only; no Integrations paste UI yet)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# openai_compatible fallback (requires INTEGRATION_MODE=live + LLM_API_KEY)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT=45

# Creative AI — image / video (Anthropic-orchestrated; local_sim without keys)
IMAGE_PROVIDER=anthropic
IMAGE_API_KEY=
IMAGE_MODEL=claude-sonnet-4-20250514
IMAGE_BASE_URL=https://api.anthropic.com
IMAGE_TIMEOUT=60
VIDEO_PROVIDER=local
VIDEO_API_KEY=
VIDEO_MODEL=veo-2.0-generate-001
VIDEO_BASE_URL=
VIDEO_TIMEOUT=120
CREATIVE_DISK=local
