# Same-origin API path (proxied by Next.js to Laravel). Use this for laptop browsers.
NEXT_PUBLIC_API_BASE_URL=/api
# Server-only origin used by next.config rewrites + Vercel Cron → Laravel workers.
# Local: http://127.0.0.1:8088
# Vercel Production (required, must be public — loopback is rejected at build):
# API_ORIGIN=https://triada-api.onrender.com
API_ORIGIN=http://127.0.0.1:8088
# Shared with apps/api CRON_SECRET. Vercel Cron Jobs send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=Triada Designs Admin
NEXT_PUBLIC_PUBLIC_SITE_URL=https://triada-designs.com
NEXT_PUBLIC_OPS_HOST=ops.triada-designs.com
