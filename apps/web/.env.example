# Same-origin API path (proxied by Next.js to Laravel for /api/v1/*). Use this for laptop browsers.
NEXT_PUBLIC_API_BASE_URL=/api
# Server-only origin used by next.config fallback rewrites + Vercel Cron → Laravel workers.
# Local: http://127.0.0.1:8088
# Vercel Production (required during dual-run — must be public; loopback is rejected at build):
# API_ORIGIN=https://api.triada-designs.com
API_ORIGIN=http://127.0.0.1:8088
# Shared with apps/api CRON_SECRET. Vercel Cron Jobs send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=Triada Designs Admin
NEXT_PUBLIC_PUBLIC_SITE_URL=https://triada-designs.com
NEXT_PUBLIC_OPS_HOST=dashboard.triada-designs.com

# --- Supabase (Next.js + Supabase migration) ---
# Required for live Postgres / Auth. Without these, Meta webhook ingest uses a local mock store.
# Auth dual-run: Next handlers at /api/v1/auth/{login,me,logout} use these (service role can
# auto-provision info@triada-designs.com). Set the same names on Vercel Production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only JWT secret (never NEXT_PUBLIC_*):
SUPABASE_JWT_SECRET=
# Optional aliases (publishable → anon, secret → service_role):
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Browser mirrors (optional; client components prefer NEXT_PUBLIC_*):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend / Gemini / Anthropic (also used by Laravel dual-run; set on Vercel if Next handlers need them) ---
# Team invites use Resend 100% when keyed (no mock send in production).
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Local/dev only — allow invite create without Resend (returns accept_url). Never set on Production.
# TRIADA_ALLOW_EMAIL_FALLBACK=1
EMAIL_CHANNEL_WEBHOOK_SECRET=
# Public dashboard URL for branded email links (content review, invites).
# Must be Production — trycloudflare / *.vercel.app / localhost are scrubbed.
NEXT_PUBLIC_APP_URL=https://dashboard.triada-designs.com
APP_URL=https://dashboard.triada-designs.com
GEMINI_API_KEY=
# Optional host env for Anthropic (Integrations UI also persists encrypted to Supabase).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Creative media pixels via Gemini Interactions (Nano Banana / Omni). Defaults used when unset.
# Do NOT set IMAGE_MODEL to Claude/text LLMs — only Gemini image/video model ids.
# IMAGE_MODEL=gemini-nano-banana-2.1
# VIDEO_MODEL=gemini-omni-1.1-flash
IMAGE_MODEL=gemini-nano-banana-2.1
VIDEO_MODEL=gemini-omni-1.1-flash
IMAGE_TIMEOUT=120
VIDEO_TIMEOUT=180
# Optional dedicated AES key for Integrations ciphertext (falls back to service role / JWT secret).
INTEGRATION_SECRETS_KEY=

# --- Google Places (popup location Autocomplete + map pin; status-only on Integrations) ---
# Prefer GOOGLE_PLACES_API_KEY; GOOGLE_MAPS_API_KEY also accepted. Restrict by HTTP referrer in Google Cloud.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional browser mirrors (same key is fine when referrer-restricted):
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Meta webhook (handled by Next Route Handler — NOT rewritten to Laravel) ---
# Callback URL: https://dashboard.triada-designs.com/api/webhooks/meta
# Alternate if api host rewrites to Vercel: https://api.triada-designs.com/api/webhooks/meta
# Must match Meta App → Webhooks Verify Token. Route also accepts META_HUB_VERIFY_TOKEN.
# Code default when unset: triada-meta-verify-2026
META_VERIFY_TOKEN=
META_HUB_VERIFY_TOKEN=
