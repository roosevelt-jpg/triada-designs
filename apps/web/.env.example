# Same-origin API path (proxied by Next.js to Laravel for /api/v1/*). Use this for laptop browsers.
NEXT_PUBLIC_API_BASE_URL=/api
# Server-only origin used by next.config fallback rewrites + Vercel Cron → Laravel workers.
# Local: http://127.0.0.1:8088
# Vercel Production (required during dual-run — must be public; loopback is rejected at build):
# API_ORIGIN=https://api.triada-designs.com
API_ORIGIN=http://127.0.0.1:8088
# Shared with apps/api CRON_SECRET. Vercel Cron Jobs send Authorization: Bearer <CRON_SECRET>.
# Required for all /api/cron/* routes — unset rejects with 503.
CRON_SECRET=
# Seed admin password for local/dev dual-run or first Supabase provision (never hardcode in source).
# TRIADA_SEED_ADMIN_PASSWORD=
# WEBCHAT_WIDGET_TOKEN=   # required for POST /api/v1/webchat/messages
# VISITOR_CAPTURE_TOKEN=  # optional alias for visitor capture off-origin
# META_APP_SECRET=        # required for Meta webhook X-Hub-Signature-256
# META_VERIFY_TOKEN=      # required for Meta webhook GET verify
# EMAIL_CHANNEL_WEBHOOK_SECRET=
# LINKEDIN_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_SECRET=
# TIKTOK_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_NAME=Triada Designs Admin
NEXT_PUBLIC_PUBLIC_SITE_URL=https://triada-designs.com
NEXT_PUBLIC_OPS_HOST=dashboard.triada-designs.com

# --- Supabase (Next.js + Supabase migration) ---
# Required for live Postgres / Auth. Without these, Meta webhook ingest uses a local mock store.
# Auth dual-run: Next handlers at /api/v1/auth/{login,me,logout} use these (service role can
# auto-provision info@triada-designs.com). Set the same names on Vercel Production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only JWT secret (never NEXT_PUBLIC_*):
SUPABASE_JWT_SECRET=
# Optional aliases (publishable → anon, secret → service_role):
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Browser mirrors (optional; client components prefer NEXT_PUBLIC_*):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend / Gemini / Anthropic (also used by Laravel dual-run; set on Vercel if Next handlers need them) ---
# Team invites use Resend 100% when keyed (no mock send in production).
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Local/dev only — allow invite create without Resend (returns accept_url). Never set on Production.
# TRIADA_ALLOW_EMAIL_FALLBACK=1
EMAIL_CHANNEL_WEBHOOK_SECRET=
# Public dashboard URL for branded email links (content review, invites).
# Must be Production — trycloudflare / *.vercel.app / localhost are scrubbed.
NEXT_PUBLIC_APP_URL=https://dashboard.triada-designs.com
APP_URL=https://dashboard.triada-designs.com
GEMINI_API_KEY=
# Optional host env for Anthropic (Integrations UI also persists encrypted to Supabase).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Creative media pixels via Gemini Interactions (Nano Banana / Omni / Pro Image).
# Do NOT set IMAGE_MODEL to Claude/text LLMs — only Gemini image/video model ids.
# GEMINI_PREFER_PAID=1 (default) tries Pro Image before Nano Banana; set 0 for Free Tier first.
# Billing: enable pay-as-you-go on the Google AI Studio project or media calls 429 (limit 0 TPM).
GEMINI_PREFER_PAID=1
# IMAGE_MODEL=gemini-3-pro-image
# VIDEO_MODEL=gemini-omni-1.1-flash
IMAGE_MODEL=gemini-3-pro-image
VIDEO_MODEL=gemini-omni-1.1-flash
IMAGE_TIMEOUT=120
VIDEO_TIMEOUT=180

# --- Higgsfield (preferred Creative image + video provider when both Key ID + Secret set) ---
# Status-only on Integrations (Connected / Waiting credentials). Never paste in the dashboard.
# Create credentials in Higgsfield Console → Authorization: Key KEY_ID:KEY_SECRET
# Official host: https://api.higgsfield.ai
# Images: Soul V2 (higgsfield-ai/soul/v2/standard)
# Videos: Seedance 2.5 text-to-video / image-to-video
# Creative resolves env first, then Integrations encrypted store (supabase_table) —
# same Anthropic/Shopify path. Gemini remains fallback when Higgsfield unset/fails.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Optional aliases (docs naming): HF_API_KEY_ID / HF_API_KEY_SECRET
# Optional override (default https://api.higgsfield.ai):
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# Optional model paths:
# HIGGSFIELD_IMAGE_ENDPOINT=higgsfield-ai/soul/v2/standard
# HIGGSFIELD_VIDEO_ENDPOINT=bytedance/seedance-2.5/text-to-video
# Optional resolution: 480p | 720p | 1080p
# HIGGSFIELD_RESOLUTION=720p
# HIGGSFIELD_VIDEO_RESOLUTION=720p
# Optional Soul V2 style UUID:
# HIGGSFIELD_STYLE_ID=3db34ab5-3439-4317-9e03-08dc30852e69
# Optional webhook signing secret (whsec_…) if inbound webhooks are enabled later:
# HIGGSFIELD_WEBHOOK_SECRET=
# Poll timeouts (seconds or ms). Image floor 90s · video floor 120s.
# HIGGSFIELD_TIMEOUT=120
# HIGGSFIELD_VIDEO_TIMEOUT=180

# Optional dedicated AES key for Integrations ciphertext (falls back to service role / JWT secret).
INTEGRATION_SECRETS_KEY=

# --- Google Places (popup location Autocomplete + map pin; status-only on Integrations) ---
# Prefer GOOGLE_PLACES_API_KEY; GOOGLE_MAPS_API_KEY also accepted. Restrict by HTTP referrer in Google Cloud.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional browser mirrors (same key is fine when referrer-restricted):
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Meta webhook (handled by Next Route Handler — NOT rewritten to Laravel) ---
# Callback URL: https://dashboard.triada-designs.com/api/webhooks/meta
# Alternate if api host rewrites to Vercel: https://api.triada-designs.com/api/webhooks/meta
# Must match Meta App → Webhooks Verify Token. Route also accepts META_HUB_VERIFY_TOKEN.
# Code default when unset: triada-meta-verify-2026
META_VERIFY_TOKEN=
META_HUB_VERIFY_TOKEN=

# --- Meta Page / Instagram (optional helpers for history import) ---
# META_PAGE_ACCESS_TOKEN is usually stored via Integrations → Meta (encrypted).
# META_PAGE_ID=118350994520677
# META_IG_USER_ID=

# --- LinkedIn / TikTok (status-only Connected when token present) ---
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_API_KEY=
# LINKEDIN_WEBHOOK_SECRET=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_API_KEY=
# TIKTOK_OPEN_ID=
# TIKTOK_WEBHOOK_SECRET=
