# Same-origin API path (proxied by Next.js to Laravel). Use this for laptop browsers.
NEXT_PUBLIC_API_BASE_URL=/api
# Server-only origin used by next.config rewrites
API_ORIGIN=http://127.0.0.1:8088
NEXT_PUBLIC_APP_NAME=Triada Designs Admin
NEXT_PUBLIC_PUBLIC_SITE_URL=https://triada-designs.com
NEXT_PUBLIC_OPS_HOST=ops.triada-designs.com
