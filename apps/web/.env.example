# Same-origin API path (proxied by Next.js to Laravel for /api/v1/*). Use this for laptop browsers.
NEXT_PUBLIC_API_BASE_URL=/api
# Server-only origin used by next.config fallback rewrites + Vercel Cron → Laravel workers.
# Local: http://127.0.0.1:8088
# Vercel Production (required during dual-run — must be public; loopback is rejected at build):
# API_ORIGIN=https://api.triada-designs.com
API_ORIGIN=http://127.0.0.1:8088
# Shared with apps/api CRON_SECRET. Vercel Cron Jobs send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=Triada Designs Admin
NEXT_PUBLIC_PUBLIC_SITE_URL=https://triada-designs.com
NEXT_PUBLIC_OPS_HOST=ops.triada-designs.com

# --- Supabase (Next.js + Supabase migration) ---
# Required for live Postgres / Auth. Without these, Meta webhook ingest uses a local mock store.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser mirrors (optional; client components prefer NEXT_PUBLIC_*):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Meta webhook (handled by Next Route Handler — NOT rewritten to Laravel) ---
# Callback URL: https://dashboard.triada-designs.com/api/webhooks/meta
# Alternate if api host rewrites to Vercel: https://api.triada-designs.com/api/webhooks/meta
META_VERIFY_TOKEN=triada-local-verify
