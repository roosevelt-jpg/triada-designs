# Names-only template for local secrets (copy to .env.local).
# Never commit real values. META_VERIFY_TOKEN (or META_HUB_VERIFY_TOKEN)
# must match Meta App Verify Token. Code default: triada-meta-verify-2026.

NEXT_PUBLIC_API_BASE_URL=/api
API_ORIGIN=http://127.0.0.1:8088
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=Triada Designs Admin
NEXT_PUBLIC_PUBLIC_SITE_URL=https://triada-designs.com
NEXT_PUBLIC_OPS_HOST=dashboard.triada-designs.com
NEXT_PUBLIC_APP_URL=https://dashboard.triada-designs.com
APP_URL=https://dashboard.triada-designs.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Optional aliases (resolved in src/lib/supabase/config.js):
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Resend / email ---
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
EMAIL_CHANNEL_WEBHOOK_SECRET=

# --- Gemini / Anthropic ---
GEMINI_API_KEY=
IMAGE_MODEL=gemini-nano-banana-2.1
VIDEO_MODEL=gemini-omni-1.1-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
INTEGRATION_SECRETS_KEY=

# --- Google Places (popup Autocomplete + map pin) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Meta webhook (Next Route Handler) ---
META_VERIFY_TOKEN=
META_HUB_VERIFY_TOKEN=
